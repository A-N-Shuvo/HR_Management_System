@{
    ViewData["Title"] = "Daily Attendance";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4>Daily Attendance Entry</h4>
            <div class="d-flex align-items-center">
                <input type="date" id="attDate" class="form-control me-2" onchange="loadAttendance()" />
                <button class="btn btn-success" onclick="saveAttendance()">Save All</button>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Employee Name</th>
                        <th>In Time</th>
                        <th>Out Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="attTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attendance.js"></script>
}