@{
    ViewData["Title"] = "Employee Management";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between">
            <h4>Employee List</h4>
            <button class="btn btn-primary btn-sm" onclick="showEmpModal()" data-bs-toggle="modal" data-bs-target="#empModal">Register New Employee</button>
        </div>
        <div class="card-body">
            <table class="table table-sm table-bordered" id="empTable">
                <thead>
                    <tr>
                        <th>Employee Id</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Gross</th>
                        <th>Join Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="empTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="empModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Employee Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="empForm">
                    <input type="hidden" id="empId" />
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Employee Id</label>
                            <input type="text" id="empCode" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Employee Name</label>
                            <input type="text" id="empName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Department</label>
                            <select id="deptId" class="form-control" required></select>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Designation</label>
                            <select id="desigId" class="form-control" required></select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label>Gender</label>
                            <select id="gender" class="form-control">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Others">Others</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label>Gross Salary</label>
                            <input type="number" id="gross" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label>Join Date</label>
                            <input type="date" id="dtJoin" class="form-control" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" onclick="saveEmployee()">Save Employee</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/employee.js"></script>
}