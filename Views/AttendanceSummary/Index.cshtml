@{
    ViewData["Title"] = "Attendance Summary";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4>Attendance Summary Generation</h4>
            <div class="d-flex gap-2">
                <input type="number" id="dtYear" class="form-control" placeholder="Year" style="width: 100px;" />
                <select id="dtMonth" class="form-control" style="width: 150px;">
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
                <button class="btn btn-primary" onclick="loadSummary()">Show List</button>
                <button class="btn btn-warning" onclick="processSummary()">Generate New Summary</button>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-sm table-bordered">
                <thead class="table-light text-center">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Present</th>
                        <th>Late</th>
                        <th>Absent</th>
                        <th>Period</th>
                    </tr>
                </thead>
                <tbody id="summaryTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attendanceSummary.js"></script>
}